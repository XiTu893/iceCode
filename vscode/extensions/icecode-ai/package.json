{
  "name": "icecode-ai",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.2.0",
  "publisher": "icecode",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Chat",
    "Machine Learning",
    "Programming Languages"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "icon": "media/icon.png",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "icecode-ai",
          "title": "%viewsContainers.activitybar.title%",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "icecode-ai": [
        {
          "type": "webview",
          "id": "icecode-ai.chat",
          "name": "%views.chat.name%",
          "when": "!icecode-ai.disabled"
        },
        {
          "id": "icecode-ai.sessions",
          "name": "%views.sessions.name%",
          "when": "!icecode-ai.disabled"
        }
      ]
    },
    "commands": [
      {
        "command": "icecode-ai.openChat",
        "title": "%command.openChat.title%"
      },
      {
        "command": "icecode-ai.newSession",
        "title": "%command.newSession.title%"
      },
      {
        "command": "icecode-ai.sendToChat",
        "title": "%command.sendToChat.title%"
      },
      {
        "command": "icecode-ai.toggleSidePanel",
        "title": "%command.toggleSidePanel.title%"
      },
      {
        "command": "icecode-ai.explainCode",
        "title": "%command.explainCode.title%"
      },
      {
        "command": "icecode-ai.fixCode",
        "title": "%command.fixCode.title%"
      },
      {
        "command": "icecode-ai.optimizeCode",
        "title": "%command.optimizeCode.title%"
      },
      {
        "command": "icecode-ai.addTests",
        "title": "%command.addTests.title%"
      },
      {
        "command": "icecode-ai.addDocs",
        "title": "%command.addDocs.title%"
      },
      {
        "command": "icecode-ai.refactorCode",
        "title": "%command.refactorCode.title%"
      },
      {
        "command": "icecode-ai.switchModel",
        "title": "%command.switchModel.title%"
      },
      {
        "command": "icecode-ai.toggleInlineCompletion",
        "title": "%command.toggleInlineCompletion.title%"
      },
      {
        "command": "icecode-ai.initProject",
        "title": "%command.initProject.title%"
      },
      {
        "command": "icecode-ai.openConfig",
        "title": "%command.openConfig.title%"
      },
      {
        "command": "icecode-ai.managePermissions",
        "title": "%command.managePermissions.title%"
      },
      {
        "command": "icecode-ai.login",
        "title": "%command.login.title%"
      },
      {
        "command": "icecode-ai.logout",
        "title": "%command.logout.title%"
      },
      {
        "command": "icecode-ai.doctor",
        "title": "%command.doctor.title%"
      },
      {
        "command": "icecode-ai.reportBug",
        "title": "%command.reportBug.title%"
      },
      {
        "command": "icecode-ai.showCost",
        "title": "%command.showCost.title%"
      },
      {
        "command": "icecode-ai.showStatus",
        "title": "%command.showStatus.title%"
      }
    ],
    "keybindings": [
      {
        "command": "icecode-ai.openChat",
        "key": "ctrl+shift+i",
        "mac": "cmd+shift+i"
      },
      {
        "command": "icecode-ai.newSession",
        "key": "ctrl+shift+alt+n",
        "mac": "cmd+shift+alt+n"
      },
      {
        "command": "icecode-ai.explainCode",
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e"
      },
      {
        "command": "icecode-ai.fixCode",
        "key": "ctrl+shift+f",
        "mac": "cmd+shift+f"
      },
      {
        "command": "icecode-ai.toggleInlineCompletion",
        "key": "ctrl+alt+space",
        "mac": "cmd+alt+space"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "icecode-ai.backendUrl": {
          "type": "string",
          "default": "localhost:50051",
          "description": "%configuration.backendUrl.description%"
        },
        "icecode-ai.model": {
          "type": "string",
          "default": "claude-sonnet-4-20250514",
          "enum": [
            "claude-sonnet-4-20250514",
            "claude-opus-4-20250514",
            "claude-haiku-3-5-20241022",
            "gpt-4o",
            "gpt-4o-mini",
            "gemini-2.5-pro",
            "deepseek-chat",
            "deepseek-coder",
            "ollama:codellama",
            "ollama:deepseek-coder"
          ],
          "description": "%configuration.model.description%"
        },
        "icecode-ai.theme": {
          "type": "string",
          "default": "dark",
          "enum": ["dark", "light"],
          "description": "%configuration.theme.description%"
        },
        "icecode-ai.fontSize": {
          "type": "number",
          "default": 14,
          "description": "%configuration.fontSize.description%"
        },
        "icecode-ai.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.autoStart.description%"
        },
        "icecode-ai.inlineCompletionEnabled": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.inlineCompletionEnabled.description%"
        },
        "icecode-ai.inlineCompletionDelay": {
          "type": "number",
          "default": 300,
          "description": "%configuration.inlineCompletionDelay.description%"
        },
        "icecode-ai.inlineCompletionProvider": {
          "type": "string",
          "default": "auto",
          "enum": ["auto", "icecode", "disabled"],
          "description": "%configuration.inlineCompletionProvider.description%"
        },
        "icecode-ai.contextLines": {
          "type": "number",
          "default": 50,
          "description": "%configuration.contextLines.description%"
        },
        "icecode-ai.saveHistory": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.saveHistory.description%"
        },
        "icecode-ai.maxHistoryItems": {
          "type": "number",
          "default": 100,
          "description": "%configuration.maxHistoryItems.description%"
        },
        "icecode-ai.mode": {
          "type": "string",
          "default": "chat",
          "enum": ["chat", "builder", "agent"],
          "enumDescriptions": ["%configuration.mode.enumDescriptions.chat%", "%configuration.mode.enumDescriptions.builder%", "%configuration.mode.enumDescriptions.agent%"],
          "description": "%configuration.mode.description%"
        },
        "icecode-ai.safetyPolicy": {
          "type": "string",
          "default": "manual",
          "enum": ["auto", "manual", "confirm"],
          "enumDescriptions": ["%configuration.safetyPolicy.enumDescriptions.auto%", "%configuration.safetyPolicy.enumDescriptions.manual%", "%configuration.safetyPolicy.enumDescriptions.confirm%"],
          "description": "%configuration.safetyPolicy.description%"
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "icecode-ai.sendToChat",
          "when": "editorHasSelection",
          "group": "icecode@1"
        },
        {
          "command": "icecode-ai.explainCode",
          "when": "editorHasSelection",
          "group": "icecode@2"
        },
        {
          "command": "icecode-ai.fixCode",
          "when": "editorHasSelection",
          "group": "icecode@3"
        },
        {
          "command": "icecode-ai.optimizeCode",
          "when": "editorHasSelection",
          "group": "icecode@4"
        },
        {
          "command": "icecode-ai.addTests",
          "when": "editorHasSelection",
          "group": "icecode@5"
        },
        {
          "command": "icecode-ai.addDocs",
          "when": "editorHasSelection",
          "group": "icecode@6"
        },
        {
          "command": "icecode-ai.refactorCode",
          "when": "editorHasSelection",
          "group": "icecode@7"
        }
      ]
    },
    "colors": [
      {
        "id": "icecode-ai.background",
        "description": "%color.background.description%",
        "defaults": {
          "dark": "#0d1117",
          "light": "#F0F4F8",
          "highContrast": "#000000"
        }
      },
      {
        "id": "icecode-ai.accent",
        "description": "%color.accent.description%",
        "defaults": {
          "dark": "#8b5cf6",
          "light": "#7c3aed",
          "highContrast": "#8b5cf6"
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=node20",
    "watch": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node20 --watch --sourcemap"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  }
}
