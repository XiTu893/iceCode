  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#6b7280", "fontStyle": "italic" }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#38bdf8" }
    },
    {
      "scope": ["keyword.control", "keyword.operator.new"],
      "settings": { "foreground": "#38bdf8" }
    },
    {
      "scope": ["constant", "constant.numeric", "constant.language"],
      "settings": { "foreground": "#fbbf24" }
    },
    {
      "scope": ["string", "punctuation.definition.string"],
      "settings": { "foreground": "#fb923c" }
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": { "foreground": "#a78bfa" }
    },
    {
      "scope": ["entity.name.class", "entity.name.type", "support.class"],
      "settings": { "foreground": "#60a5fa" }
    },
    {
      "scope": ["variable", "variable.other"],
      "settings": { "foreground": "#e6edf3" }
    },
    {
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#fb923c" }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#fb923c" }
    },
    {
      "scope": ["meta.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#38bdf8" }
    },
    {
      "scope": ["support.type.property-name", "meta.property-name"],
      "settings": { "foreground": "#a78bfa" }
    },
    {
      "scope": ["support.constant.property-value", "meta.property-value"],
      "settings": { "foreground": "#fb923c" }
    },
    {
      "scope": ["punctuation"],
      "settings": { "foreground": "#8b949e" }
    },
    {
      "scope": ["operator"],
      "settings": { "foreground": "#38bdf8" }
    },
    {
      "scope": ["markup.heading"],
      "settings": { "foreground": "#8b5cf6", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "scope": ["markup.raw", "markup.fenced_code"],
      "settings": { "foreground": "#fb923c" }
    },
    {
      "scope": ["markup.link"],
      "settings": { "foreground": "#3b82f6", "fontStyle": "underline" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#ef4444" }
    },
    {
      "scope": ["meta.decorator", "punctuation.decorator"],
      "settings": { "foreground": "#fb923c" }
    },
    {
      "scope": ["string.regexp"],
      "settings": { "foreground": "#38bdf8" }
    },
    {
      "scope": ["string.escape"],
      "settings": { "foreground": "#fb923c" }
    }
  ]
}
