  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#4A5568", "fontStyle": "italic" }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#BD93F9" }
    },
    {
      "scope": ["keyword.control", "keyword.operator.new"],
      "settings": { "foreground": "#FF79C6" }
    },
    {
      "scope": ["constant", "constant.numeric", "constant.language"],
      "settings": { "foreground": "#FFD93D" }
    },
    {
      "scope": ["string", "punctuation.definition.string"],
      "settings": { "foreground": "#00D68F" }
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": { "foreground": "#00D4FF" }
    },
    {
      "scope": ["entity.name.class", "entity.name.type", "support.class"],
      "settings": { "foreground": "#60A5FA" }
    },
    {
      "scope": ["variable", "variable.other"],
      "settings": { "foreground": "#E2E8F0" }
    },
    {
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#FFB86C" }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#FFB86C" }
    },
    {
      "scope": ["meta.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#FF79C6" }
    },
    {
      "scope": ["support.type.property-name", "meta.property-name"],
      "settings": { "foreground": "#00D4FF" }
    },
    {
      "scope": ["support.constant.property-value", "meta.property-value"],
      "settings": { "foreground": "#00D68F" }
    },
    {
      "scope": ["punctuation"],
      "settings": { "foreground": "#8892B0" }
    },
    {
      "scope": ["operator"],
      "settings": { "foreground": "#FF79C6" }
    },
    {
      "scope": ["markup.heading"],
      "settings": { "foreground": "#00D4FF", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "scope": ["markup.raw", "markup.fenced_code"],
      "settings": { "foreground": "#00D68F" }
    },
    {
      "scope": ["markup.link"],
      "settings": { "foreground": "#0099FF", "fontStyle": "underline" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#FF6B6B" }
    },
    {
      "scope": ["meta.decorator", "punctuation.decorator"],
      "settings": { "foreground": "#FFB86C" }
    },
    {
      "scope": ["string.regexp"],
      "settings": { "foreground": "#FF79C6" }
    },
    {
      "scope": ["string.escape"],
      "settings": { "foreground": "#FFB86C" }
    }
  ]
}
